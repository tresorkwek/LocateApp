@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using System.Collections.Generic;
@using System.Linq;
@using System;
@using LocateApp.Models;
@using LocateApp.ViewModels;

@{ // Binding du ViewModel.
    LoginViewModel Page = (LoginViewModel)Model;
    string appName = Page.AppName;
    string company = Page.Company;
    string alertClass = Page.TypeAlert == "error" ? "danger" : (string.IsNullOrEmpty(Page.TypeAlert) ? "secondary" : Page.TypeAlert);
}
<!DOCTYPE html>
<html lang="fr" dir="ltr" data-bs-theme="light">
<head>
    <title>@Page.Titre</title>
    <meta name="description" content="@Page.Titre" />
    @Html.Partial("Views/Layout/_Head.cshtml")
</head>
<body class="auth-bg">
    <div class="container-xxl">
        <div class="row vh-100 d-flex justify-content-center">
            <div class="col-12 align-self-center">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-4 col-md-6 mx-auto">
                            <div class="card">
                                <div class="card-body p-0 bg-black auth-header-box rounded-top">
                                    <div class="text-center p-3">
                                        <a href="/" class="logo logo-admin">
                                            <img src="~/Content/images/locate-logo.png" alt="Locate" class="auth-logo" />
                                        </a>
                                        <h4 class="mt-3 mb-1 fw-semibold text-white fs-18">Bienvenue sur @appName</h4>
                                        <p class="text-muted fw-medium mb-0">Connectez-vous pour continuer.</p>
                                    </div>
                                </div>
                                <div class="card-body pt-0">

                                    @if (!string.IsNullOrEmpty(Page.Alerte))
                                    {
                                        <div class="alert alert-@(alertClass) mt-3 mb-0 d-flex align-items-center" role="alert">
                                            <i class="material-icons me-2">@Page.Icone</i>
                                            <div>@Page.Alerte</div>
                                        </div>
                                    }

                                    <form class="my-4" method="post">
                                        <div class="form-group mb-2">
                                            <label class="form-label" for="UserName">Compte</label>
                                            <input type="text" class="form-control" id="UserName" name="UserName" placeholder="Votre identifiant" autofocus />
                                        </div>

                                        <div class="form-group">
                                            <label class="form-label" for="Password">Mot de passe</label>
                                            <input type="password" class="form-control" id="Password" name="Password" placeholder="Votre mot de passe" />
                                        </div>

                                        <div class="form-group row mt-3">
                                            <div class="col-sm-12">
                                                <div class="form-check form-switch form-switch-success">
                                                    <input class="form-check-input" type="checkbox" id="RememberMe" name="RememberMe" value="1" />
                                                    <label class="form-check-label" for="RememberMe">Se souvenir de moi</label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group mb-0 row">
                                            <div class="col-12">
                                                <div class="d-grid mt-3">
                                                    <button class="btn btn-primary" type="submit">Connexion <i class="fas fa-sign-in-alt ms-1"></i></button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>

                                    <div class="text-center mb-2">
                                        <p class="text-muted mb-0">&copy; @DateTime.Now.Year @company</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Content/approx/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
