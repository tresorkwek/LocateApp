@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ BilletEnvoiViewModel Page = (BilletEnvoiViewModel)Model; }

@{ ViewBag.Page = Page; }

@{ Layout = "Views/Layout/_Layout.cshtml"; }


<div class="no-p">
    <div class="bg-info">
        <div>
            <div class="row">
                <div class="col-12 col-md-12 col-lg-12">
                    <div class="card card-transparent no-m">
                        <div class="card-body text-white p-0">
                            <div class="row" style="margin: 0px;">
                                <div class="col-6 text-start">

                                    <div class="col-12 col-md-6 col-lg-7 text-center">
                                        <span class="mt-4 f-s-12">BANQUE CENTRALE DU CONGO</span><br />
                                        <img src="~/Content/images/logoBcc.png" width="100px" alt="">
                                        <address>
                                            <span class="mt-4 f-s-10">Direction des Ressources Humaines </span> <br />
                                            Service Centre de Santé
                                        </address>
                                    </div>

                                </div>

                                <div class="col-6 text-end">

                                    <div style="margin-top:0px;">
                                        <div class="text-center">

                                            <img src="~/Content/images/photos/@Page.BilletEnvoi.Patient.Photo" style="width: 120px;" alt="" class="rounded-circle mailbox-profile-image shadow-sm">

                                            <span class="fw-semibold text-white f-s-12">
                                                @Page.BilletEnvoi.Patient.Matricule <br />

                                                @Page.BilletEnvoi.Patient.NomAfficheable @Page.BilletEnvoi.Patient.PostnomAfficheable @Page.BilletEnvoi.Patient.PrenomAfficheable <br />

                                                <span class="text-muted small text-dark f-s-12">
                                                    @Page.BilletEnvoi.Patient.TypeString (@Page.BilletEnvoi.Patient.Genre)<br />
                                                    @Page.BilletEnvoi.Patient.DateNaissance
                                                </span>

                                            </span>

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div>
        <div class="row">

            <div class="card-title mt-4 text-center f-bold">
                @Page.Title.ToUpper() N° @Page.BilletEnvoi.NumBilletEnvoi
            </div>

            <div class="col-12 col-md-12 col-lg-12">
                <div class="card card-transparent no-m">
                    <div class="card-body invoice-relative-content p-0">
                        <div class="row">


                            <span class="fw-semibold text-dark f-s-13">

                                <div class="col-6 text-start">
                                    <p>
                                        <span class="text-primary">Date d'émission</span><br>
                                        <b>@Page.BilletEnvoi.DateCreation.ToString("D")</b><br>
                                    </p>
                                </div>
                                <div class="col-6 text-end">
                                    <p>
                                        <span class="text-primary">Date d'expiration</span><br>
                                        <b>@Page.BilletEnvoi.DateExpiration.ToString("D")</b><br>
                                    </p>
                                </div>
                            </span>


                        </div>
                        <div class="row">

                            <div class="col-12 col-md-12 col-lg-12">
                                <span class="fw-semibold text-dark f-s-12">

                                    @{string medecin = Page.BilletEnvoi.ServiceBilletEnvois.Count > 1 ? "Mmes/Mrs les Médecins" : "Mme/Mr le Médecin";}

                                    @{ string services = "";
                                        int compteur = 0;
                                        string raison = !string.IsNullOrEmpty(Page.BilletEnvoi.Observation) ? $"{Page.BilletEnvoi.Observation}" : "les soins appropriés";

                                        foreach (var service in Page.BilletEnvoi.ServiceBilletEnvois)
                                        {
                                            compteur++;                                            
                                            services += Page.BilletEnvoi.ServiceBilletEnvois.Count > 1 ? (compteur == 1 ? $"<b>{service.Denomination}</b>" : (Page.BilletEnvoi.ServiceBilletEnvois.Count == compteur ? $"<b> et {service.Denomination}</b>" : $"<b>, {service.Denomination}</b>")) : $"<b>{service.Denomination}</b>";

                                        }

                                        services += "<b>.</b>";


                                        string article = Page.BilletEnvoi.ServiceBilletEnvois.Count > 1 ? "des Services" : "du Service";
                                        string pronom = Page.BilletEnvoi.ServiceBilletEnvois.Count > 1 ? "vos Services" : "votre Service";

                                        string texteIntro = Page.BilletEnvoi.ServiceBilletEnvois.Count > 1 ? $"{medecin} des Services  {services}" : $"{medecin} {article} {services}";

                                        string facture = Page.BilletEnvoi.ServiceBilletEnvois.Count > 1 ? "les factures à chaque Service correspondant" : "la facture au Service bien identifié en marge"; }





                                    @Html.Raw(texteIntro)

                                </span>


                            </div>



                        </div>

                        <div class="row">
                            <div class="col-12 col-md-6 col-lg-8">

                                <span class="fw-semibold text-dark f-s-12">

                                    <p class="text-justify"> Voudriez-vous avoir l'obligeance de recevoir dans @pronom le malade mieux identifié ci-dessus à <b>@Page.BilletEnvoi.Hopital.Denomination</b>  votre Formation Médicale d'attache pour @raison. </p>
                                    <br />
                                    <p class="text-justify">
                                        Les <b>frais</b> étant à la charge de la <b>Banque Centrale du Congo</b> (frais de repas exceptés), la présente tient lieu
                                        d'attestation de <b>prise en charge.</b>
                                    </p>

                                    <br />

                                    <p class="text-justify">
                                        <u><b>N.B</b></u> : Nous vous prions de lier obligatoirement <b>@facture</b> pour nous permettre le paiement. Nous souhaitons avoir votre avis médical par écrit et sous pli fermé sur son état de santé.
                                    </p>

                                </span>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4 text-end">
                                <div class="text-right">

                                    <div style="margin-top:0px;">
                                        <div class="text-center">

                                            @*<img src="@ImageCreator.GetQrCode(Page.BilletEnvoi.Patient.SerialId.ToString())" width="80px" />*@

                                            <span class="fw-semibold text-dark">
                                                Dr  @Page.BilletEnvoi.Agent.NomAfficheable @Page.BilletEnvoi.Agent.PostnomAfficheable @Page.BilletEnvoi.Agent.PrenomAfficheable <br />

                                                <span class="text-muted small">
                                                    @Page.BilletEnvoi.Agent.Telephone
                                                </span>

                                            </span>

                                        </div>
                                    </div>

                                    <span class="fw-semibold text-dark f-s-12">
                                        Imprimé le @DateTime.Now.ToString("f")
                                    </span>


                                    <div class="border-top my-2"></div>
                                </div>
                            </div>                           

                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

    

    @{ string printUrl = $"/billetenvoi/{Page.Identity.IdInstitution}/select/{Page.BilletEnvoi.Id}";

            string backUrl = $"/billetenvoi/{Page.Identity.IdInstitution}/print/{Page.BilletEnvoi.Id}";
          

            string nomPatientToPrint = Page.BilletEnvoi.Patient.NomAfficheable.Trim() + " " + Page.BilletEnvoi.Patient.PostnomAfficheable.Trim() + " " + Page.BilletEnvoi.Patient.PrenomAfficheable.Trim();
            string imageBoxToPrint = $"<img src =\\'/Content/images/photos/{Page.BilletEnvoi.Patient.Photo}\\' width=\\'130px\\'  class=\\'circle mailbox-profile\\'>";
            string onclikToPrint = $"$(this).printAndCconfirmUrl('{printUrl}', 'Impression <br/> {imageBoxToPrint}', '{backUrl}', 'Avez-vous pu imprimer correctement le billet d\\'envoi N°{Page.BilletEnvoi.NumBilletEnvoi} de <div class=\\'chip\\'> {nomPatientToPrint.Replace("'", @"\'")} </div> pour {Page.BilletEnvoi.Hopital.Denomination} ?', 'Echec de l\\'impression du billet d\\'envoi N°{Page.BilletEnvoi.NumBilletEnvoi} de <div class=\\'chip\\'> {nomPatientToPrint.Replace("'", @"\'")} </div> pour {Page.BilletEnvoi.Hopital.Denomination}')";

        }

        <div class="fab-action invisibleForPrint">
            <a class="btn btn-danger" onclick="@Html.Raw(onclikToPrint)">
                <i class="iconoir-printer"></i>
            </a>
        </div>




</div>