@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using System.Collections.Generic;
@using System.Linq;
@using System;
@using LocateApp.Models;
@using LocateApp.ViewModels;

@{ // Binding du ViewModel.
    LoginViewModel Page = (LoginViewModel)Model;
    string appName = Page.AppName;
    string alertClass = Page.TypeAlert == "error" ? "danger" : (string.IsNullOrEmpty(Page.TypeAlert) ? "secondary" : Page.TypeAlert);
    string prenom = Page.Identity?.Prenom;
}
<!DOCTYPE html>
<html lang="fr" dir="ltr" data-bs-theme="light">
<head>
    <title>@Page.Title</title>
    @Html.Partial("Views/Layout/_Head.cshtml")
</head>
<body class="auth-bg">
    <div class="container-xxl">
        <div class="row vh-100 d-flex justify-content-center">
            <div class="col-12 align-self-center">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-4 col-md-6 mx-auto">
                            <div class="card">
                                <div class="card-body p-0 bg-black auth-header-box rounded-top">
                                    <div class="text-center p-3">
                                        <img src="~/Content/images/photos/@Page.Identity.Photo" class="rounded-circle avatar-xl border border-2 border-primary" alt="" />
                                        <h4 class="mt-3 mb-1 fw-semibold text-white fs-18">Nouveau mot de passe</h4>
                                        <p class="text-muted fw-medium mb-0">@prenom, choisissez un nouveau mot de passe pour @appName.</p>
                                    </div>
                                </div>
                                <div class="card-body pt-0">

                                    @if (!string.IsNullOrEmpty(Page.Alerte))
                                    {
                                        <div class="alert alert-@(alertClass) mt-3 mb-0 d-flex align-items-center" role="alert">
                                            <i class="material-icons me-2">@Page.Icone</i>
                                            <div>@Page.Alerte</div>
                                        </div>
                                    }

                                    <form class="my-4" method="post">
                                        <input type="hidden" value="@Page.Identity.UserName" name="UserName" />

                                        <div class="form-group mb-2">
                                            <label class="form-label" for="ExPassword">Ancien mot de passe</label>
                                            <input type="password" class="form-control required" id="ExPassword" name="ExPassword" autofocus />
                                        </div>

                                        <div class="form-group mb-2">
                                            <label class="form-label" for="Password">Nouveau mot de passe</label>
                                            <input type="password" class="form-control required" id="Password" name="Password" />
                                        </div>

                                        <div class="form-group">
                                            <label class="form-label" for="ConfirmPassword">Confirmer le mot de passe</label>
                                            <input type="password" class="form-control required" id="ConfirmPassword" name="ConfirmPassword" />
                                        </div>

                                        <div class="form-group mb-0 row">
                                            <div class="col-12">
                                                <div class="d-flex justify-content-end gap-2 mt-3">
                                                    <button type="reset" class="btn btn-light">Annuler</button>
                                                    <button type="submit" class="btn btn-primary">Valider <i class="fas fa-check ms-1"></i></button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Content/approx/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
