@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ HopitalViewModel Page = (HopitalViewModel)Model; }

@{ ViewBag.Page = Page;
    string libellePage = Page.MenuData?.Libelle;
 }

@{ Layout = "Views/Layout/_Layout.cshtml";}

<div>
    <div class="row">
        <div class="col-12 col-md-12 col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@libellePage</h4>
                    <p>@Page.Description</p><br>
                    <table id="example" class="table table-hover align-middle w-100">
                        <thead>
                            <tr>
                                <th>N°</th>
                                <th>Code</th>
                                <th>Denomination</th>
                                <th>Acronyme</th>
                                <th>DateConv</th>
                                <th>DateCreation</th>
                                <th>Public</th>
                                <th>Actif</th>
                                <th>Opération</th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th>N°</th>
                                <th>Code</th>
                                <th>Denomination</th>
                                <th>Acronyme</th>
                                <th>DateConv</th>
                                <th>DateCreation</th>
                                <th>Public</th>
                                <th>Actif</th>
                                <th>Opération</th>
                            </tr>
                        </tfoot>
                        <tbody>

                            @{string link;
                                int compteur = 0; }

                            @foreach (var hopital in Page.Hopitaux)
                            {
                                link = Page.Link + hopital.Id;
                                compteur++;

                                <tr>
                                    <td valign="top">@compteur </td>
                                    <td valign="top">@hopital.Id </td>
                                    <td>
                                        @hopital.Denomination

                                        @if (!hopital.IsHospital)
                                        {
                                            <a class="btn btn-light text-danger" data-bs-placement="right" data-bs-toggle="tooltip" title="Pharmacie">
                                                <i class="material-icons">medication</i>
                                            </a>
                                            <span class="transparent-text">Pharmacie</span> 
                                        }
                                        else
                                        {
                                            <span class="transparent-text">Hôpital</span>
                                        }

                                    </td>
                                    <td>@hopital.Acronyme </td>
                                    <td>
                                        @if (hopital.DateConv.Year != 1) 
                                        { 
                                            @hopital.DateConv.ToString("dd MMMM yyyy")
                                        } 
                                    </td>
                                    <td>@hopital.DateCreation.ToString("dd MMMM yyyy") </td>                                    
                                    <td>

                                        @if (hopital.IsPublic)
                                        {
                                            <a class="btn btn-light text-success" data-bs-placement="right" data-bs-toggle="tooltip" title="Publique">
                                                <i class="iconoir-eye"></i>
                                            </a>
                                            <span class="transparent-text">Public visible </span> 
                                        }
                                        else
                                        {
                                            <a class="btn btn-light text-danger" data-bs-placement="right" data-bs-toggle="tooltip" title="Privé">
                                                <i class="iconoir-eye-closed"></i>
                                            </a>
                                            <span class="transparent-text">Privé Invisible</span>
                                        }

                                    </td>                                    
                                    <td>

                                        @if (hopital.IsActive)
                                        {
                                            <a class="btn btn-light text-success" data-bs-placement="right" data-bs-toggle="tooltip" title="Actif">
                                                <i class="material-icons">verified_user</i>
                                            </a>
                                            <span class="transparent-text">Actif</span>
                                         }

                                    </td>

                                    <td>
                                        <a href="@Html.Raw(link)" class="btn btn-light text-primary" data-bs-placement="left" data-bs-toggle="tooltip" title="Voir les mouvements">
                                            <i class="iconoir-search"></i>                                            
                                        </a>
                                    </td>

                                </tr>
                             }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="fab-action">

            <a href="/hopital/add/" class="btn btn-success" data-bs-placement="left" data-bs-toggle="tooltip" title="Ajouter un Hopital">
                <i class="iconoir-plus"></i>
            </a>

        </div>

    </div>
</div>