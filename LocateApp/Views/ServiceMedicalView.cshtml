@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ ServiceMedicalViewModel Page = (ServiceMedicalViewModel)Model; }

@{ ViewBag.Page = Page;
   string libellePage = Page.MenuData?.Libelle;
}

@{ Layout = "Views/Layout/_Layout.cshtml";}

<div>
    <div class="row">
        <div class="col-12 col-md-12 col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@libellePage</h4>
                    <p>@Page.Description</p><br>
                    <table id="example" class="table table-hover align-middle w-100">
                        <thead>
                            <tr>
                                <th>N°</th>
                                <th>Code</th>
                                <th>Libellé</th>
                                <th>Acronyme</th>
                                <th>Auto approbation</th>
                                <th>Opération</th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th>N°</th>
                                <th>Code</th>
                                <th>Libellé</th>
                                <th>Acronyme</th>
                                <th>Auto approbation</th>
                                <th>Opération</th>
                            </tr>
                        </tfoot>
                        <tbody>

                            @{string link;
                              int compteur = 0; 
                             }

                            @foreach (var serviceMedical in Page.ServiceMedical)
                            {
                                link = Page.Link + serviceMedical.IdService;
                                compteur++;

                                <tr>
                                    <td valign="top">@compteur </td>
                                    <td valign="top">@serviceMedical.IdService </td>
                                    <td>@serviceMedical.Denomination </td>                                    
                                    <td>@serviceMedical.Acronyme </td>                                    
                                    <td>

                                        @if (serviceMedical.AutoApprobation)
                                        {
                                            <a class="btn btn-light text-success" data-bs-placement="right" data-bs-toggle="tooltip" title="Auto approbation">
                                                <i class="material-icons">verified_user</i>
                                            </a>
                                            <span class="transparent-text">Auto approbation</span> 
                                        }   

                                    </td>
                                    <td>
                                      
                                        <a href="@Html.Raw(link)" class="btn btn-light text-primary" data-bs-placement="left" data-bs-toggle="tooltip" title="Modifier">
                                            <i class="iconoir-edit-pencil"></i>
                                        </a>                                       

                                    </td>

                                </tr>
                             }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="fab-action">

            <a href="/servicemedical/add/" class="btn btn-success" data-bs-placement="left" data-bs-toggle="tooltip" title="Créer un nouveau Service Médical">
                <i class="iconoir-plus"></i>
            </a>

        </div>

    </div>
</div>