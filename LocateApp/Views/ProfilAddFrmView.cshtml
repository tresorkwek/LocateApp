@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using System.Collections.Generic;
@using System.Linq;
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ ViewModel Page = (ViewModel)Model; }

@{ ViewBag.Page = Page; }

@{ Layout = "Views/Layout/_LayoutForm.cshtml"; }

<form class="lc-form" method="post" action="/profil/add/">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card mb-0">
                <div class="card-header">
                    <div class="row align-items-center g-2">
                        <div class="col">
                            <h4 class="card-title">@Page.Title</h4>
                            <p class="lc-card-subtitle">Créez le profil, puis attribuez-lui des droits sur les menus de l'application.</p>
                        </div>
                        <div class="col-auto lc-card-actions">
                            <a href="/profil/" class="btn btn-sm btn-light"><i class="iconoir-arrow-left me-1"></i>Profils</a>
                        </div>
                    </div>
                </div>
                <div class="card-body">

                    <div class="lc-section-title"><i class="iconoir-user-badge-check"></i>Identification</div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label" for="Nom">Nom<span class="lc-req">*</span></label>
                            <input id="Nom" name="Nom" type="text" class="form-control" placeholder="Ex. Gestionnaire">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="Libelle">Libellé</label>
                            <input id="Libelle" name="Libelle" type="text" class="form-control" placeholder="Ex. Gestionnaire du patrimoine">
                        </div>
                    </div>

                    <div class="lc-section-title"><i class="iconoir-lock"></i>Accès</div>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="border rounded p-3">
                                <div class="form-check form-switch m-0">
                                    <input role="switch" type="checkbox" id="Externe" name="Externe" value="true" class="form-check-input" />
                                    <label class="form-check-label" for="Externe">
                                        <span class="fw-medium d-block">Profil externe</span>
                                        <span class="d-block fs-12 text-muted">Pour les utilisateurs extérieurs à l'organisation : ils ne reçoivent que les droits attribués explicitement, sans les menus par défaut des agents.</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="HomeUrl">Page d'accueil</label>
                            <div class="lc-input-icon">
                                <i class="iconoir-home-simple"></i>
                                <input id="HomeUrl" name="HomeUrl" type="text" class="form-control" placeholder="Ex. /immo/">
                            </div>
                            <div class="form-text">Adresse ouverte après la connexion des utilisateurs de ce profil.</div>
                        </div>
                    </div>

                </div>
                <div class="card-footer lc-form-actions">
                    <span class="lc-form-actions-start"><span class="lc-req">*</span> champ obligatoire</span>
                    <a href="/profil/" class="btn btn-light">Annuler</a>
                    <button type="submit" class="btn btn-primary"><i class="iconoir-check me-1"></i>Créer le profil</button>
                </div>
            </div>
        </div>
    </div>
</form>
