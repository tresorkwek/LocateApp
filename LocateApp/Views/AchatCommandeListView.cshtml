@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using System.Collections.Generic;
@using System.Linq;
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;

@{ AchatCommandeListViewModel Page = (AchatCommandeListViewModel)Model; }

@{ ViewBag.Page = Page; }

@{ Layout = "Views/Layout/_Layout.cshtml"; }

@{
    int nbBrouillon = Page.Commandes.Count(c => c.Statut == StatutCommande.Brouillon || c.Statut == StatutCommande.Rejetee);
    int nbSoumise = Page.Commandes.Count(c => c.Statut == StatutCommande.Soumise);
    int nbEnCours = Page.Commandes.Count(c => c.Statut == StatutCommande.Validee || c.Statut == StatutCommande.PartiellementLivree);
    int nbTerminee = Page.Commandes.Count(c => c.Statut == StatutCommande.Livree || c.Statut == StatutCommande.Cloturee);
    int nbCommandes = Page.Commandes.Count;

    // Badges de statut : icône par statut ; « Clôturée » lisible en thème clair comme en thème sombre.
    Func<int, string> iconeStatut = s => s == StatutCommande.Brouillon ? "iconoir-page-edit"
        : s == StatutCommande.Soumise ? "iconoir-clock"
        : s == StatutCommande.Validee ? "iconoir-check"
        : s == StatutCommande.PartiellementLivree ? "iconoir-delivery-truck"
        : s == StatutCommande.Livree ? "iconoir-check-circle"
        : s == StatutCommande.Cloturee ? "iconoir-lock"
        : s == StatutCommande.Rejetee ? "iconoir-xmark-circle"
        : "iconoir-info-circle";
    Func<int, string> classeStatut = s => s == StatutCommande.Cloturee ? "bg-dark-subtle text-body" : StatutCommande.Badge(s);
}

@if (!Page.AValider)
{
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-xl-3">
            <div class="lc-kpi">
                <span class="lc-kpi-icon bg-secondary-subtle text-secondary"><i class="iconoir-page-edit"></i></span>
                <div>
                    <p class="lc-kpi-label">À compléter</p>
                    <p class="lc-kpi-value">@nbBrouillon<small>brouillons ou rejetées</small></p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="lc-kpi">
                <span class="lc-kpi-icon bg-warning-subtle text-warning"><i class="iconoir-clock"></i></span>
                <div>
                    <p class="lc-kpi-label">En attente de validation</p>
                    <p class="lc-kpi-value">@nbSoumise<small>soumises</small></p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="lc-kpi">
                <span class="lc-kpi-icon bg-primary-subtle text-primary"><i class="iconoir-delivery-truck"></i></span>
                <div>
                    <p class="lc-kpi-label">En cours de livraison</p>
                    <p class="lc-kpi-value">@nbEnCours<small>validées</small></p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="lc-kpi">
                <span class="lc-kpi-icon bg-success-subtle text-success"><i class="iconoir-check-circle"></i></span>
                <div>
                    <p class="lc-kpi-label">Terminées</p>
                    <p class="lc-kpi-value">@nbTerminee<small>livrées ou clôturées</small></p>
                </div>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <div class="row align-items-center g-2">
            <div class="col">
                <h4 class="card-title">@(Page.AValider ? "Commandes en attente de validation" : "Commandes d'achat")</h4>
                <p class="lc-card-subtitle">@(Page.AValider ? "Ouvrez une commande soumise pour la valider ou la rejeter avec un motif." : "Du brouillon à la livraison : suivez chaque commande passée auprès des fournisseurs.")</p>
            </div>
            <div class="col-auto lc-card-actions">
                @if (Page.AValider)
                {
                    <a href="/achat/commande/" class="btn btn-light"><i class="iconoir-list me-1"></i>Toutes les commandes</a>
                }
                else if (Page.PeutCreer)
                {
                    <a href="/achat/commande/add/" class="btn btn-primary"><i class="iconoir-plus me-1"></i>Nouvelle commande</a>
                }
            </div>
        </div>
    </div>
    <div class="card-body pt-0">
        @if (nbCommandes == 0)
        {
            <div class="lc-empty">
                <div class="lc-empty-icon"><i class="iconoir-cart"></i></div>
                @if (Page.AValider)
                {
                    <h6>Aucune commande à valider</h6>
                    <p>Toutes les commandes soumises ont été traitées.</p>
                    <a href="/achat/commande/" class="btn btn-light btn-sm"><i class="iconoir-list me-1"></i>Toutes les commandes</a>
                }
                else
                {
                    <h6>Aucune commande d'achat</h6>
                    <p>Saisissez une commande auprès d'un fournisseur : elle sera soumise à validation puis réceptionnée.</p>
                    if (Page.PeutCreer)
                    {
                        <a href="/achat/commande/add/" class="btn btn-primary btn-sm"><i class="iconoir-plus me-1"></i>Nouvelle commande</a>
                    }
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="example" class="table lc-table w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Commande</th>
                            <th>Date</th>
                            <th>Fournisseur</th>
                            <th class="text-end">Montant</th>
                            <th style="min-width: 150px;">Livraison</th>
                            <th>Statut</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var commande in Page.Commandes)
                        {
                            <tr>
                                <td>
                                    <div class="lc-entity">
                                        <span class="lc-thumb bg-primary-subtle text-primary"><i class="iconoir-cart"></i></span>
                                        <div class="lc-entity-body">
                                            <a href="/achat/commande/id/@commande.Id" class="lc-name">@commande.Numero</a>
                                            <span class="lc-sub">@commande.NbreLignes ligne(s) · @commande.QuantiteCommandee unité(s)</span>
                                        </div>
                                    </div>
                                </td>
                                <td data-order="@commande.DateCommande.ToString("yyyyMMdd")">@commande.DateCommande.ToString("dd/MM/yyyy")</td>
                                <td><span class="text-body">@commande.Fournisseur</span></td>
                                <td class="lc-num" data-order="@commande.MontantReference.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <span class="fw-semibold text-body">@Utilities.FormatNumber(commande.Montant)</span> <small class="text-muted">@commande.Devise</small>
                                    @if (!commande.EstEnDeviseReference)
                                    {
                                        <span class="d-block fs-12 text-muted">≈ @Utilities.FormatNumber(commande.MontantReference) @Page.Devise</span>
                                    }
                                </td>
                                <td data-order="@commande.PourcentageRecu.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress lc-progress flex-grow-1">
                                            <div class="progress-bar @(commande.PourcentageRecu >= 100 ? "bg-success" : "bg-info")" style="width: @(commande.PourcentageRecu)%"></div>
                                        </div>
                                        <small class="text-muted text-nowrap">@commande.QuantiteRecue / @commande.QuantiteCommandee</small>
                                    </div>
                                </td>
                                <td><span class="badge lc-badge @classeStatut(commande.Statut)"><i class="@iconeStatut(commande.Statut)"></i>@commande.StatutLibelle</span></td>
                                <td class="text-end">
                                    <span class="lc-actions">
                                        <a href="/achat/commande/id/@commande.Id" title="Voir la commande" data-bs-toggle="tooltip"><i class="iconoir-eye"></i></a>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
