@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using System.Collections.Generic;
@using System.Linq;
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ EtiquetteFormatListViewModel Page = (EtiquetteFormatListViewModel)Model; }

@{ ViewBag.Page = Page;
    string libellePage = Page.MenuData?.Libelle;
    List<EtiquetteFormat> formats = Page.EtiquetteFormats ?? new List<EtiquetteFormat>();
 }

@{ Layout = "Views/Layout/_Layout.cshtml";}

<div class="card">
    <div class="card-header">
        <div class="row align-items-center g-2">
            <div class="col">
                <h4 class="card-title">@libellePage</h4>
                <p class="lc-card-subtitle">Disposition des planches d'étiquettes QR : nombre de lignes et de colonnes, taille de chaque étiquette et papier.</p>
            </div>
            <div class="col-auto lc-card-actions">
                <a href="/etiquette/format/add/" class="btn btn-primary"><i class="iconoir-plus me-1"></i>Nouveau format</a>
            </div>
        </div>
    </div>
    <div class="card-body pt-0">
        @if (formats.Count == 0)
        {
            <div class="lc-empty">
                <div class="lc-empty-icon"><i class="iconoir-view-grid"></i></div>
                <h6>Aucun format d'étiquette</h6>
                <p>Définissez un premier format pour pouvoir commander des planches d'étiquettes QR.</p>
                <a href="/etiquette/format/add/" class="btn btn-primary btn-sm"><i class="iconoir-plus me-1"></i>Nouveau format</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="example" class="table lc-table w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Format</th>
                            <th>Disposition</th>
                            <th>Taille d'une étiquette</th>
                            <th>Papier</th>
                            <th>Visibilité</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var etiquetteFormat in formats)
                        {
                            string link = Page.Link + etiquetteFormat.Id;
                            int parPage = etiquetteFormat.Ligne * etiquetteFormat.Colone;
                            string nomFormatEtiquette = $"{etiquetteFormat.Nom} ({etiquetteFormat.Ligne} lignes × {etiquetteFormat.Colone} colonnes, {etiquetteFormat.Largeur} × {etiquetteFormat.Hauteur} mm, {etiquetteFormat.Papier})";
                            string nomFormatJs = nomFormatEtiquette.Replace("\\", "\\\\").Replace("'", "\\'").Replace("\"", "&quot;");
                            string onclik = $"$(this).confirmUrl('Suppression', '/etiquette/format/delete/{etiquetteFormat.Id}', 'Êtes-vous sûr de vouloir supprimer le format : <br/> <div class=\\'chip\\'> {nomFormatJs} </div> ?', 'Suppression du format <div class=\\'chip\\'> {nomFormatJs} </div> annulée')";

                            <tr>
                                <td>
                                    <div class="lc-entity">
                                        <span class="lc-thumb bg-primary-subtle text-primary"><i class="iconoir-view-grid"></i></span>
                                        <div class="lc-entity-body">
                                            <a href="@Html.Raw(link)" class="lc-name">@etiquetteFormat.Nom</a>
                                            <span class="lc-sub">@parPage étiquettes par page</span>
                                        </div>
                                    </div>
                                </td>
                                <td data-order="@parPage">
                                    <span class="d-block text-body">@etiquetteFormat.Ligne lignes × @etiquetteFormat.Colone colonnes</span>
                                </td>
                                <td data-order="@(etiquetteFormat.Largeur * etiquetteFormat.Hauteur)">
                                    <span class="lc-code">@etiquetteFormat.Largeur × @etiquetteFormat.Hauteur mm</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(etiquetteFormat.Papier))
                                    {
                                        <span class="badge lc-badge bg-secondary-subtle text-secondary"><i class="iconoir-page"></i>@etiquetteFormat.Papier</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (etiquetteFormat.IsPublic)
                                    {
                                        <span class="badge lc-badge bg-success-subtle text-success"><i class="iconoir-community"></i>Public</span>
                                    }
                                    else
                                    {
                                        <span class="badge lc-badge bg-secondary-subtle text-secondary"><i class="iconoir-lock"></i>Privé</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="lc-actions">
                                        <a href="/etiquette/format/modify/@etiquetteFormat.Id" title="Modifier" data-bs-toggle="tooltip"><i class="iconoir-edit-pencil"></i></a>
                                        <a onclick="@Html.Raw(onclik)" class="lc-danger" role="button" title="Supprimer" data-bs-toggle="tooltip"><i class="iconoir-trash"></i></a>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
