@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ PatientCarteViewModel Page = (PatientCarteViewModel)Model; }

@{ ViewBag.Page = Page;
    int compteur = 0;
    string pagination;
  }

@{ Layout = "Views/Layout/_Layout.cshtml";}

<div  style="padding-top: 0px; padding-left: 0px; padding-bottom: 0px; padding-right: 0px;margin-top: 0px; margin-left: -10px; margin-bottom: 0px; margin-right: 0px;">

    @foreach (var patient in Page.Patients)
    {
         compteur++;
         pagination = compteur == Page.Patients.Count? "page-break-after: avoid;" : "page-break-after:always;"; 

        <span style="page-break-after:always;">
            <div class="row" style="padding-right:0px;margin-right:0px;">
                <!--<div class="col-12">
                    <div class="page-title">--> @*@patient.Direction*@<!--</div>
                </div>-->
                <div class="col-12 col-md-4 col-lg-5" style="padding-right:0px;">
                    
                    <div class="card" style="height: 732px; width: 100%; background: url('/Content/images/body_background.jpg') no-repeat; background-size: cover; margin-top: -2px; margin-left: 0px; margin-bottom: 0px; margin-right: 0px;">
                        <div class="card-body text-center" style="padding-top:0px;padding-left:0px;padding-right:0px;">

                            @{string couleur = patient.TypeString == "Agent" ? (patient.Actif == 1 ? "blue" : "orange") : "green";
                                int nbrePatientModifiable = (patient.Statut[0] == "0") ? 1 : 0;
                                int nbrePatientPrisEnCharge = (patient.PrisEnCharge == "OUI") ? 1 : 0;
                                string titleCard = "Carte d'accès aux soins médicaux";
                                string banniere = $"'/Content/images/fondbanire{couleur}.jpg'"; }

                            <p class="mt-4" style="background: center url(@banniere); background-size: cover; padding-top:11px;margin-bottom:10px; width:100%;  height:100%; background-repeat:no-repeat;">
                                <img src="~/Content/images/logoBcc.png" width="110px" />
                            </p>

                            <p class="mt-4 text-danger f-s-22 f-bold fa-underline"> <u>@titleCard.ToUpper()</u>  </p>

                            <br />

                            <p class="mt-4 f-bold text-dark f-s-28">@patient.Matricule</p>

                            <img src="~/Content/images/photos/@patient.Photo" class="img-fluid rounded-circle" width="290px" alt="">

                            <br /><br />

                            <p class="mt-4 f-bold text-dark f-s-28">

                                @Html.Raw(ForString.ShowCorrectionBetween(patient.Nom, patient.NomAfficheable))  @Html.Raw(ForString.ShowCorrectionBetween(patient.Postnom, patient.PostnomAfficheable)) @Html.Raw(ForString.ShowCorrectionBetween(patient.Prenom, patient.PrenomAfficheable))

                            </p>

                            <div class="chip mt-2 @couleur text-white f-s-20" style="padding-top:2px;padding-bottom:3px;">
                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  @patient.TypeString.ToUpper() &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                <br />
                            </div>
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            <div class="chip mt-2 @couleur text-white f-s-20" style="padding-top:2px;padding-bottom:3px;">
                                &nbsp;&nbsp;&nbsp;  @Html.Raw(ForString.ShowCorrectionBetween(patient.Genre.ToUpper(), patient.GenreAfficheable.ToUpper())) &nbsp;&nbsp;&nbsp;
                                <br />
                            </div>

                        </div>

                    </div>

                </div>

            </div>
        </span>


        <span style="page-break-after: always;">
            <div class="row" >
                <!--<div class="col-12">
                    <div class="page-title">--> @*@patient.Direction*@<!--</div>
                </div>-->
                <div class="col-12 col-md-4 col-lg-5">
                    <div class="card" style="height: 730px; width: 460px;margin-top: 0px; margin-left: 0px; margin-bottom: 0px; margin-right: 0px; transform: rotate(180deg);;">
                        <div class="card-body">

                            <br /><br />

                            <p class="mt-4 text-center f-bold text-dark f-s-20">INSTRUCTIONS</p>

                            <br />

                            <p class="mt-4 text-dark f-bold f-s-20 fa-align-justify line-e">

                                <ol >
                                    <li class="f-s-18 fa-align-justify text-dark f-bold" style="line-height:2em;">Cette carte donne droit à son détenteur aux bénéfices des soins de santé dans les formations médicales de collaboration. <br /></li>
                                    <li class="f-s-18 fa-align-justify text-dark f-bold" style="line-height:2em;">Elle doit être presentée à chaque consultation.<br /></li>
                                    <li class="f-s-18 fa-align-justify text-dark f-bold" style="line-height:2em;">En aucun cas, cette carte ne peut être cédée à des tiers.<br /></li>
                                    <li class="f-s-18 fa-align-justify text-dark f-bold" style="line-height:2em;">La perte de la carte doit être immédiatement signalée à la DRH.<br /></li>
                                </ol>

                            </p>
                            <br />

                            <p class="text-center"><img src="@ImageCreator.GetQrCode(patient.SerialId.ToString())" width="260px" /></p>

                        </div>

                    </div>

                </div>

            </div>
        </span>

    }

    <div class="fab-action invisibleForPrint">
        <a class="btn btn-danger" href="#" onclick="javascript: window.print(); window.close();">
            <i class="iconoir-printer"></i>
        </a>
    </div>

</div>
