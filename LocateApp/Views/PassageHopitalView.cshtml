@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ PassageHopitalViewModel Page = (PassageHopitalViewModel)Model; }

@{ ViewBag.Page = Page;
    string libellePage = Page.MenuData?.Libelle;
 }

@{ Layout = "Views/Layout/_Layout.cshtml";}

<div>
    <div class="row">
        <div class="col-12">
<br/><br/>
            <p>@Page.PassageHopitaux[0].BilletEnvoi.Hopital.Denomination</p>
        </div>
        <div class="col-12">
            @{ int compteur = 0; string classCss; string icone;}
            <section id="cd-timeline" class="cd-container">

                @foreach (var passageHopital in Page.PassageHopitaux)
                {
                    compteur++;
                    classCss = compteur % 2 == 0 ? "cd-picture" : "cd-movie";
                    icone = compteur % 2 == 0 ? "cd-icon-picture.svg" : "cd-icon-movie.svg";

                    <div class="cd-timeline-block">
                        <div class="cd-timeline-img @classCss">
                            <img src="~/Content/plugins/vertical-timeline/img/@icone" alt="@passageHopital.ServiceHopital.Denomination">
                        </div> <!-- cd-timeline-img -->

                        <div class="cd-timeline-content">
                            <h2>@passageHopital.ServiceHopital.Denomination</h2>
                            <p>                            
                                <div>
                                    <div>
                                        <div class="float-start">
                                            <div class="float-start">
                                                <img src="~/Content/images/photos/@passageHopital.BilletEnvoi.Patient.Photo" data-zoom-image="~/Content/images/photos/@passageHopital.BilletEnvoi.Patient.Photo" alt="" class="rounded-circle mailbox-profile-image shadow-sm" onmouseover="$(this).elevateZoom({ scrollZoom: true, zoomWindowPosition: -11 })">
                                            </div>
                                            <div class="float-start">
                                                <span class="fw-semibold">
                                                    <table class="table table-hover align-middle w-100">
                                                        <tr>
                                                            <td>
                                                                Nip : @passageHopital.BilletEnvoi.Patient.Matricule <br />
                                                                Nom : @Html.Raw(ForString.ShowCorrectionBetween(passageHopital.BilletEnvoi.Patient.Nom, passageHopital.BilletEnvoi.Patient.NomAfficheable)) <br />
                                                                Postnom : @Html.Raw(ForString.ShowCorrectionBetween(passageHopital.BilletEnvoi.Patient.Postnom, passageHopital.BilletEnvoi.Patient.PostnomAfficheable)) <br />
                                                                Prénom : @Html.Raw(ForString.ShowCorrectionBetween(passageHopital.BilletEnvoi.Patient.Prenom, passageHopital.BilletEnvoi.Patient.PrenomAfficheable))<br />
                                                                Sexe : @Html.Raw(ForString.ShowCorrectionBetween(passageHopital.BilletEnvoi.Patient.Genre, passageHopital.BilletEnvoi.Patient.GenreAfficheable))
                                                            </td>
                                                            <td valign="top">
                                                            </td>
                                                        </tr>
                                                    </table>
                                                    @{string naissance = (passageHopital.BilletEnvoi.Patient.Sexe == 1) ? "Né" : "Née";}
                                                    <span class="text-muted small">
                                                        @naissance le @passageHopital.BilletEnvoi.Patient.DateNaissance (@passageHopital.BilletEnvoi.Patient.EtatCivil : @passageHopital.BilletEnvoi.Patient.TypeString)
                                                    </span>

                                                </span>
                                            </div>

                                        </div>
                                    </div>
                                </div> 
                            
                            </p>
                            <a href="/billetenvoi/select/@passageHopital.BilletEnvoi.Id" class="btn btn-light">Billet d'envoi</a>
                            <span class="cd-date">@passageHopital.DatePassage.ToString("dddd, dd MMMM yyyy à H:mm")</span>
                        </div> <!-- cd-timeline-content -->
                    </div> <!-- cd-timeline-block -->
                }               


            </section> <!-- cd-timeline -->

        </div>
    </div>
</div>