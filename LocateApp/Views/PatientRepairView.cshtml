@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ PatientViewModel Page = (PatientViewModel)Model; }

@{ ViewBag.Page = Page;
   string libellePage = Page.MenuData?.Libelle;
}

@{ Layout = "Views/Layout/_Layout.cshtml";}

<div>
    <input type="hidden" id="NbrePatientTotal" name="NbrePatientTotal" value="@Page.Patients.Count" />
    <div class="row">
        <div class="col-12 col-md-12 col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@libellePage</h4>
                    <p>@Page.Description</p><br>
                    <table id="example" class="table table-hover align-middle w-100">
                        <thead>
                            <tr>
                                <th>Matricule</th>
                                <th>Identité</th>
                                <th>Direction</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th>Matricule</th>
                                <th>Identité</th>
                                <th>Direction</th>
                                <th>Action</th>
                            </tr>
                        </tfoot>
                        <tbody>
                            @{ int compteur = 0;}

                            @foreach (var patient in Page.Patients)
                            {
                                compteur++;
                        <tr>
                            <td valign="top"><a href="/patient/select/@patient.Matricule.Substring(0, 6)"> @patient.Matricule </a> </td>
                            <td>
                                @{string naissance = (patient.Sexe == 1) ? "Né" : "Née";}

                                <div>
                                    <div>
                                        <div class="float-start">
                                            <div class="float-start">
                                                <img src="~/Content/images/photos/@patient.Photo" data-zoom-image="/Content/images/photos/@patient.Photo" alt="" class="rounded-circle mailbox-profile-image shadow-sm" onmouseover="$(this).elevateZoom({ scrollZoom: true, zoomWindowPosition: -11 })">
                                            </div>
                                            <div class="float-start">
                                                <span class="fw-semibold">
                                                    <table class="table table-hover align-middle w-100">
                                                        <tr>
                                                            <td>
                                                                Nom : @Html.Raw(ForString.ShowCorrectionBetween(patient.Nom, patient.NomAfficheable)) <br />
                                                                Postnom : @Html.Raw(ForString.ShowCorrectionBetween(patient.Postnom, patient.PostnomAfficheable)) <br />
                                                                Prénom : @Html.Raw(ForString.ShowCorrectionBetween(patient.Prenom, patient.PrenomAfficheable))<br />
                                                                Sexe : @Html.Raw(ForString.ShowCorrectionBetween(patient.Genre, patient.GenreAfficheable))
                                                            </td>
                                                            <td valign="top">

                                                                @if (!string.IsNullOrEmpty(patient.MoviaCommentaire))
                                                                {
                                                <div class="form-group mb-3 col-12">
                                                    <label class="form-label" for="Commentaire">Commentaire</label>
                                                    <textarea id="Commentaire" name="Commentaire" class="form-control" readonly>

                                                                                        @Html.Raw(patient.MoviaCommentaire)

                                                                                    </textarea>
                                                </div>}

                                                            </td>
                                                        </tr>
                                                    </table>
                                                    <span class="text-muted small">
                                                        @naissance le @patient.DateNaissance (@patient.EtatCivil : @patient.TypeString)
                                                    </span>

                                                </span>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>@patient.Direction </td>
                            <td>
                                @{string couleur = (patient.TypeString == "Agent") ? (patient.Actif == 1) ? "blue" : "orange" : "green";}
                                <input type="hidden" name="PatientToDelete_@compteur" id="PatientToDelete_@compteur" value="@patient.Matricule" />
                                <ul id="dropdown_@compteur" class="dropdown-menu">
                                    <li><a href="/patient/restore/@patient.Matricule">Retablissant ?</a></li>
                                    <li><a href="/patient/validate/@patient.Matricule">Corrigeant ?</a></li>
                                    <li><a href="/patient/transfert/@patient.Matricule"> => à la DRH ?</a></li>
                                    <li><a href="/patient/delete/@patient.Matricule"><font color="red"> Supprimant ? </font> </a></li>
                                </ul>
                                <a class="btn dropdown-toggle @couleur btn-primary" href="#!" data-activates="dropdown_@compteur">Reparer en<i class="mdi-navigation-arrow-drop-down float-end"></i></a>

                            </td>
                        </tr>
}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>