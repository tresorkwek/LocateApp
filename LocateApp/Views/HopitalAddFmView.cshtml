@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using LocateApp.Models;
@using LocateApp.ViewModels;


@{ // Binding du ViewModel.
    BilletEnvoiFmViewModel Page = (BilletEnvoiFmViewModel)Model; }

@{ ViewBag.Page = Page; }

@{ Layout = "Views/Layout/_LayoutForm.cshtml"; }


<div>
    <div>
        <div class="row">
            <div class="col-12 col-md-12 col-lg-6 offset-lg-4 offset-md-1">
                <div class="card">
                    <div class="card-body">

                        <div class="mt-4 text-center text-danger">@Page.Title.ToUpper()</div>
                        <br/><br />

                        <p class="mt-4 text-center">@Page.Patient.Matricule.Trim()</p>

                        <img src="~/Content/images/photos/@Page.Patient.Photo" width="228px" class="rounded-circle" alt="">

                        <p class="mt-4 text-center">
                            @Page.Patient.NomAfficheable  @Page.Patient.PostnomAfficheable @Page.Patient.PrenomAfficheable
                        </p>


                       <br/><br />

                        <div class="row">
                            <form class="col-12" method="post" action="@Page.Link">

                                <input type="hidden" name="Nip" id="Nip" value="@Page.Patient.Matricule.Trim()" />

                                <div class="col-12">

                                    <label class="mt-4 f-s-13 f-bold">Formation Medicale</label>

                                    <select class="js-states form-select" tabindex="-1" style="width: 100%" name="RefCodeHopital" id="RefCodeHopital">
                                        <option value="" disabled selected>Choisissez l'hôpital</option>                                        

                                        @foreach (var hopital in Page.Hopital)
                                        {
                                            <option value="@hopital.Id">@hopital.Denomination</option>
                                        }

                                    </select>

                                </div>

                                <br/><br /><br/><br /><br/><br />

                                <div class="col-12">

                                    <label class="mt-4 f-s-13 f-bold">Service Medical</label>

                                    <select class="js-states form-select" tabindex="-1" multiple="multiple" style="width: 100%" name="Specialites" id="Specialites">
                                                                               

                                    </select>

                                </div>

                                <br /><br />
                                @{ 
                                    string libelle = (Page.Patient.Sexe == 1) ? "Ce patient est transféré pour :" : "Cette patiente est transférée pour :";
                                }

                            <div class="form-group mb-3 col-12">
                                <label for="Observation">@libelle </label>
                                <br />
                                <textarea id="Observation" name="Observation" class="form-control">Prise en charge totale</textarea>
                            </div>

                                <div class="col-12 text-end mt-2">
                                    <button type="reset" class="btn btn-light">Annuler</button>
                                    <button type="submit" class="btn btn-success">Générer</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>