@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using System.Collections.Generic;
@using System.Linq;
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ ViewModel Page = (ViewModel)Model; }

@{ ViewBag.Page = Page; }

@{ Layout = "Views/Layout/_LayoutForm.cshtml"; }

<form class="lc-form" method="post" action="/inventaire/add/">
    <div class="row g-3 justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card mb-0">
                <div class="card-header">
                    <h4 class="card-title">@Page.Title</h4>
                    <p class="lc-card-subtitle">Ouvrez la campagne d'inventaire de l'année pour recenser les biens sur le terrain.</p>
                </div>
                <div class="card-body">

                    <div class="lc-section-title"><i class="iconoir-calendar"></i>Campagne</div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label" for="Annee">Année<span class="lc-req">*</span></label>
                            <div class="lc-input-icon">
                                <i class="iconoir-calendar"></i>
                                <input id="Annee" name="Annee" type="text" inputmode="numeric" maxlength="4" class="form-control" placeholder="Ex. @DateTime.Now.Year" autocomplete="off">
                            </div>
                            <div class="form-text">Une seule campagne par année.</div>
                        </div>
                    </div>

                    <div class="lc-callout">
                        <i class="iconoir-info-circle"></i>
                        <div>Une seule campagne peut être ouverte à la fois : clôturez l'inventaire en cours avant d'en lancer un nouveau.</div>
                    </div>

                </div>
                <div class="card-footer lc-form-actions">
                    <span class="lc-form-actions-start"><span class="lc-req">*</span> champ obligatoire</span>
                    <a href="/inventaire/" class="btn btn-light">Annuler</a>
                    <button type="submit" class="btn btn-primary"><i class="iconoir-check me-1"></i>Lancer l'inventaire</button>
                </div>
            </div>
        </div>
    </div>
</form>
