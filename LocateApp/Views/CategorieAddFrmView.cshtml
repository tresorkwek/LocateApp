@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using System.Collections.Generic;
@using System.Linq;
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ CategorieAddOrModifyFrmViewModel Page = (CategorieAddOrModifyFrmViewModel)Model; }

@{ ViewBag.Page = Page; }

@{ Layout = "Views/Layout/_LayoutForm.cshtml"; }

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <a href="/categorie/" class="d-inline-flex align-items-center gap-1 text-muted mb-3"><i class="iconoir-arrow-left"></i>Retour aux catégories</a>

        <form class="lc-form" method="post" action="/categorie/add/">
            <div class="card mb-0">
                <div class="card-header">
                    <div class="lc-entity">
                        <span class="lc-thumb lc-thumb-lg bg-primary-subtle text-primary"><i class="iconoir-folder-plus"></i></span>
                        <div class="lc-entity-body">
                            <h4 class="card-title">@(string.IsNullOrEmpty(Page.Title) ? "Nouvelle catégorie" : Page.Title)</h4>
                            <p class="lc-card-subtitle">Une catégorie regroupe des articles de même nature au sein d'une famille.</p>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="Designation">Désignation<span class="lc-req">*</span></label>
                            <input id="Designation" name="Designation" type="text" class="form-control" placeholder="Ex. Mobilier de bureau">
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="IdFamille">Famille<span class="lc-req">*</span></label>
                            <select name="IdFamille" class="js-states form-select" tabindex="-1" style="width: 100%" id="IdFamille">
                                @foreach (var famille in Page.Familles)
                                {
                                    <option value="@famille.Id">@famille.Nom</option>
                                }
                            </select>
                            <div class="form-text">La famille sert à regrouper les statistiques du patrimoine.</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer lc-form-actions">
                    <span class="lc-form-actions-start"><span class="lc-req">*</span> champs obligatoires</span>
                    <a href="/categorie/" class="btn btn-light">Annuler</a>
                    <button type="submit" class="btn btn-primary"><i class="iconoir-check me-1"></i>Créer la catégorie</button>
                </div>
            </div>
        </form>
    </div>
</div>
