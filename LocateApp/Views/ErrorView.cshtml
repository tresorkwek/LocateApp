@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using System.Collections.Generic;
@using System.Linq;
@using System;
@using LocateApp.Models;
@using LocateApp.ViewModels;

@{ // Binding du ViewModel.
    ErrorViewModel Page = (ErrorViewModel)Model;
    string appName = Page.AppName;
    string title = Page.Code == 404 ? "Page introuvable" : (Page.Code == 403 || Page.Code == 401 ? "Accès refusé" : "Une erreur est survenue");
}
<!DOCTYPE html>
<html lang="fr" dir="ltr" data-bs-theme="light">
<head>
    <title>@Page.Titre</title>
    @Html.Partial("Views/Layout/_Head.cshtml")
</head>
<body class="auth-bg">
    <div class="container-xxl">
        <div class="row vh-100 d-flex justify-content-center">
            <div class="col-12 align-self-center">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-4 col-md-6 mx-auto">
                            <div class="card">
                                <div class="card-body p-0 bg-black auth-header-box rounded-top">
                                    <div class="text-center p-3">
                                        <a href="@Page.HomeUrl" class="logo logo-admin">
                                            <img src="~/Content/images/locate-logo.png" alt="Locate" class="auth-logo" />
                                        </a>
                                        <h4 class="mt-3 mb-1 fw-semibold text-white fs-18">@title</h4>
                                        <p class="text-muted fw-medium mb-0">@Page.Company</p>
                                    </div>
                                </div>
                                <div class="card-body pt-0">
                                    <div class="ex-page-content text-center">
                                        <i class="iconoir-warning-triangle text-warning d-block mt-4" style="font-size: 72px;"></i>
                                        <h1 class="my-2">@Page.Code</h1>
                                        <h5 class="fs-16 text-muted mb-4">@Page.Alerte</h5>
                                    </div>
                                    <a class="btn btn-primary w-100" href="@Page.HomeUrl">Retour à l'accueil de @appName <i class="fas fa-home ms-1"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Content/approx/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
