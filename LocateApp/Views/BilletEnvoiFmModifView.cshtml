@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using System.Linq;
@using System.Collections.Generic;


@{ // Binding du ViewModel.
    BilletEnvoiViewModel Page = (BilletEnvoiViewModel)Model; }

@{ ViewBag.Page = Page; }

@{ 
    Layout = "Views/Layout/_LayoutForm.cshtml"; 
}


<div>
    <div>
        <div class="row">
            <div class="col-12 col-md-12 col-lg-6 offset-lg-4 offset-md-1">
                <div class="card">
                    <div class="card-body">

                        <div class="mt-4 text-center text-danger">@Page.Title.ToUpper()</div>
                        <br/><br />

                        <p class="mt-4 text-center">@Page.BilletEnvoi.Patient.Matricule.Trim()</p>

                        <img src="~/Content/images/photos/@Page.BilletEnvoi.Patient.Photo" width="228px" class="rounded-circle" alt="">

                        <p class="mt-4 text-center">
                            @Page.BilletEnvoi.Patient.NomAfficheable  @Page.BilletEnvoi.Patient.PostnomAfficheable @Page.BilletEnvoi.Patient.PrenomAfficheable
                        </p>

                       <br/>

                        <div class="row">
                            <form class="col-12" method="post" action="@Page.Link">

                                <input type="hidden" name="Nip" id="Nip" value="@Page.BilletEnvoi.Patient.Matricule.Trim()" />
                                <input type="hidden" name="Id" id="Id" value="@Page.BilletEnvoi.Id" />

                                <div class="col-12">

                                    <p class="mt-4 text-start f-s-16">
                                        Formation Medicale : <b>@Page.BilletEnvoi.Hopital.Denomination</b>
                                    </p>

                                    <input type="hidden" name="IdHopital" id="IdHopital" value="@Page.BilletEnvoi.IdHopital" />

                                </div>

                                <br /><br />

                                <div class="col-12">

                                    <label class="mt-4 f-s-13 f-bold">Service Medical</label>

                                    <select class="js-states form-select" tabindex="-1" multiple="multiple" style="width: 100%" name="Specialites" id="Specialites">

                                        @{ string selected;}

                                        @foreach (var service in Page.BilletEnvoi.Hopital.Services)
                                        {


                                            selected = Page.BilletEnvoi.ServiceBilletEnvois.Exists(x => service.IdService == x.IdService) ? "selected=\"selected\"" : "";

                                            if (Page.BilletEnvoi.ServiceBilletEnvois.Exists(x => x.IsUsed == false && service.IdService == x.IdService))
                                            {
                                                <option value="@service.IdService" @Html.Raw(selected)>@service.Denomination</option>
                                            }
                                            else if (!Page.BilletEnvoi.ServiceBilletEnvois.Exists(x => service.IdService == x.IdService))
                                            {
                                                <option value="@service.IdService">@service.Denomination</option>
                                            }
                                        }

                                    </select>

                                </div>

                                <br /><br />
                                @{ string libelle = (Page.BilletEnvoi.Patient.Sexe == 1) ? "Ce patient est transféré pour :" : "Cette patiente est transférée pour :"; }

                                <div class="form-group mb-3 col-12">
                                    <label for="Observation">@libelle </label>
                                    <br />
                                    <textarea id="Observation" name="Observation" class="form-control">@Page.BilletEnvoi.Observation</textarea>
                                </div>

                                <div class="col-12 text-end mt-2">
                                    <button type="reset" class="btn btn-light">Annuler</button>
                                    <button type="submit" class="btn btn-success">Modifier</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>