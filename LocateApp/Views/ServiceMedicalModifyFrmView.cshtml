@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ ServiceMedicalModifyFrmViewModel Page = (ServiceMedicalModifyFrmViewModel)Model; }

@{ ViewBag.Page = Page; }

@{ Layout = "Views/Layout/_LayoutForm.cshtml"; }

<div>
    <div>
        <div class="row">
            <div class="col-12 col-md-12 col-lg-8 offset-lg-2 offset-md-1"> 
                <div class="card">
                    <div class="card-body">
                        <div class="card-title"><br />
                            <p class="mt-4 text-center text-primary">@Page.Title</p>
                        </div>
                        <div class="row">
                            <form class="col-12" method="post" action="/servicemedical/modify/">
                                <input type="hidden" name="IdService" id="IdService" value="@Page.ServiceMedical.IdService" />

                                <div class="form-group mb-3 col-10"><br />
                                    <label class="form-label" for="Denomination">Nom</label>
                                    <input id="Denomination" name="Denomination" type="text" value="@Page.ServiceMedical.Denomination" class="form-control">
                                </div>

                                <div class="form-group mb-3 col-12">
                                    <br />
                                </div>

                                <div class="form-group mb-3 col-10"><br />
                                    <label class="form-label" for="Acronyme">Acronyme</label>
                                    <input id="Acronyme" name="Acronyme" type="text" value="@Page.ServiceMedical.Acronyme" class="form-control">
                                </div>

                                <div class="form-group mb-3 col-12">
                                    <br />
                                </div>

                                <div class="form-group mb-3 col-10">
                                    Auto Approbation
                                </div>

                                <div class="form-group mb-3 col-10">

                                    @{ string checkedAutoApprobation = Page.ServiceMedical.AutoApprobation ? "checked=\"checked\"" : "";}

                                    <div class="form-check form-switch mb-3">
<input role="switch" type="checkbox" id="AutoApprobation" name="AutoApprobation" value="true" @checkedAutoApprobation class="form-check-input" />
<label class="form-check-label" for="AutoApprobation">Oui</label>
</div>

                                </div>

                                <div class="form-group mb-3 col-12">
                                    <br />
                                </div>
                                <div class="form-group mb-3 col-12">
                                    <br />
                                </div>



                                <div class="col-12 text-center mt-2">
                                    <button type="reset" class="btn btn-light">Annuler</button>
                                    <button type="submit" class="btn btn-success">Modifier</button>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>        
</div>