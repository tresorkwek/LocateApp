@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;


@{ PatientFamilleForPrintViewModel Page = (PatientFamilleForPrintViewModel)Model; }

@{ ViewBag.Page = Page; }

@{ Layout = "Views/Layout/_Layout.cshtml";}

<div>
    <section class="cd-products-comparison-table">

        <form action="/agent/impression/" method="post">

            <div class="comparison-table-options">
                <span class="page-title">@Page.Patients[0].Direction  </span>
                <div class="actions">

                    <button type="reset" class="btn btn-light">Annuler</button>
                    <button type="submit" class="btn btn-success">@Page.Button</button>

                </div>
            </div>

            <div class="cd-products-table">
                <div class="features">
                    <div class="top-info">Famille @Page.Patients[0].Nom <br /><a href="/patient/select/@Page.Patients[0].Matricule.Substring(0, 6)"> @Page.Patients[0].Matricule.Substring(0, 6) </a></div>
                    <ul class="cd-features-list">
                        <li>NIP</li>
                        <li>Nom</li>
                        <li>Postnom</li>
                        <li>Prénom</li>
                        <li>Sexe</li>
                        <li>Date de naissance</li>
                        <li>Etat-civil</li>
                        <li>Statut</li>
                    </ul>
                </div> <!-- .features -->

                <div class="cd-products-wrapper">
                    <ul class="cd-products-columns">

                        @{ int nbrePatient = 0;}

                        @foreach (var patient in Page.Patients)
                        {
                            if (patient.PrisEnCharge == "OUI")
                            {                              
                                nbrePatient++;
                                string idCheckBox = "Matricule" + nbrePatient;                                 

                                <li class="product">
                                    <div class="top-info">
                                        <h3>
                                            <img src="~/Content/images/photos/@patient.Photo" class="img-fluid rounded-circle" alt="product image" />
                                        </h3>
                                    </div> <!-- .top-info -->

                                    @{string dateNaissance = patient.DateNaissanceBrute.Date.ToString("dd/MM/yyyy");}

                                    <ul class="cd-features-list">
                                        <li style="@Page.CheckBoxStyle">

                                            <span class="p-v-xs" style="text-align:center;marging: 0px 0px 0px 0px;padding: 0px 0px 0px 0px;">
                                                <div class="form-check"><input type="checkbox" id="@idCheckBox" name="Imprimer" value="@patient.Matricule.Trim()"  class="form-check-input"/>
                                                <label class="form-check-label" for="@idCheckBox">@patient.Matricule</label></div>
                                            </span>
                                            <input type="hidden" name="Matricule" value="@patient.Matricule.Trim()" />

                                        </li>
                                        <li style="@Page.InputStyle">  @Html.Raw(ForString.ShowInput(patient.NomAfficheable.Trim(), "Nom", Page.IsModification)) </li>
                                        <li style="@Page.InputStyle">  @Html.Raw(ForString.ShowInput(patient.PostnomAfficheable?.Trim(), "Postnom", Page.IsModification)) </li>
                                        <li style="@Page.InputStyle">  @Html.Raw(ForString.ShowInput(patient.PrenomAfficheable?.Trim(), "Prenom", Page.IsModification)) </li>
                                        <li style="@Page.SelectStyle"> @Html.Raw(ForString.ShowInput(patient.SexeAfficheable + "", "Sexe", Page.IsModification, "select", patient.GenreAfficheable, Page.Sexe)) </li>
                                        <li style="@Page.InputStyle">  @Html.Raw(ForString.ShowInput(dateNaissance, "DateNaissance", Page.IsModification, "date", patient.DateNaissance)) </li>
                                        <li style="@Page.SelectStyle"> @Html.Raw(ForString.ShowInput(patient.SituationFamiliale + "", "EtatCivil", Page.IsModification, "select", patient.EtatCivil, Page.EtatCivil)) </li>
                                        <li>@patient.TypeString &nbsp;</li>
                                    </ul>
                                </li><!-- .product -->
                             }
                         
                         }

                    </ul> <!-- .cd-products-columns -->
                </div> <!-- .cd-products-wrapper -->

                <ul class="cd-table-navigation">
                    <li><a href="#0" class="prev inactive">Prev</a></li>
                    <li><a href="#0" class="next">Next</a></li>
                </ul>
            </div> <!-- .cd-products-table -->

        </form>

    </section> <!-- .cd-products-comparison-table -->
       
    @{ double widthOfWindow = Math.Round(37.7952755906 * 5.5,1);}
    <div class="fab-action">
        <a class="btn btn-danger" href="#" onclick="javascript: window.open('/agent/carte/@Page.Patients[0].Matricule.Substring(0, 6)', '_blank', 'toolbar=no,scrollbars=yes,resizable=no,top=200,left=500, width=450')">
            <i class="iconoir-printer"></i>
        </a>
    </div>
    

</div>
