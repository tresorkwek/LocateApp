@using System;
@using System.Collections.Generic;
@using System.Linq;
@using LocateApp.ViewModels;
@using LocateApp.Models;
@using LocateApp.Utilities;

@{ // Binding du ViewModel.
    ViewModel PageLayout = (ViewModel)ViewBag.Page.Value;
    PageLayout.Identity.Nom = PageLayout.Identity.Nom?.Substring(0, 1).ToUpper() + PageLayout.Identity.Nom?.Substring(1).ToLower();
    PageLayout.Identity.Prenom = PageLayout.Identity.Prenom?.Substring(0, 1).ToUpper() + PageLayout.Identity.Prenom?.Substring(1).ToLower();
    PageLayout.Identity.Postnom = PageLayout.Identity.Postnom?.Substring(0, 1).ToUpper() + PageLayout.Identity.Postnom?.Substring(1).ToLower();

    string photoUser = Utilities.GetPhotoAgentPath() + PageLayout.Identity.Photo;
    string userFullName = (PageLayout.Identity.Nom + " " + PageLayout.Identity.Postnom).Trim();
    string homeUrl = string.IsNullOrEmpty(PageLayout.Identity.Profil?.HomeUrl) ? "/" : PageLayout.Identity.Profil.HomeUrl;
    string appVersion = PageLayout.AppVersion;
    string company = PageLayout.Company;
    string pageLibelle = PageLayout.MenuData?.Libelle;
    string pageTitle = string.IsNullOrEmpty(pageLibelle) ? PageLayout.Title : pageLibelle;

    Predicate<GroupMenu> matchProfil = x => x.Section == "Profil" && x.Visible;
    List<GroupMenu> groupsMenuProfil = PageLayout.Identity.GroupMenu.FindAll(matchProfil);

    // Rubrique du menu contenant la page courante (fil d'Ariane) et sous-titre de la page.
    GroupMenu groupeCourant = null;
    foreach (var g in PageLayout.Identity.GroupMenu)
    {
        if (g.Section == "Principale" && g.Menu != null && g.Menu.Count > 1 && g.Menu.Exists(m => m.Nom == PageLayout.CurrentClaim)) { groupeCourant = g; break; }
    }
    string pageSousTitre = PageLayout.Description;
    if (pageSousTitre == pageTitle) { pageSousTitre = null; }
    string prenomSalutation = string.IsNullOrEmpty(PageLayout.Identity.Prenom) ? PageLayout.Identity.Nom : PageLayout.Identity.Prenom;
    string salutation = (DateTime.Now.Hour < 18 ? "Bonjour" : "Bonsoir") + (string.IsNullOrEmpty(prenomSalutation) ? "" : ", " + prenomSalutation) + " !";
}
<!DOCTYPE html>
<html lang="fr" dir="ltr" data-startbar="dark" data-bs-theme="light">
<head>
    <title>@(string.IsNullOrWhiteSpace(PageLayout.Title) ? (string.IsNullOrWhiteSpace(pageTitle) ? PageLayout.AppName : pageTitle + " · " + PageLayout.AppName) : PageLayout.Title)</title>
    <meta name="description" content="@PageLayout.Description" />
    @Html.Partial("Views/Layout/_Head.cshtml")
</head>
<body class="@PageLayout.BodyClass" onload="@Html.Raw(PageLayout.OnLoad)">

    <input type="hidden" name="AlerteTitle" id="AlerteTitle" value="@PageLayout.AlerteTitle" />
    <input type="hidden" name="TypeAlert" id="TypeAlert" value="@PageLayout.TypeAlert" />
    <input type="hidden" name="AlertColor" id="AlertColor" value="@PageLayout.AlertColor" />
    <input type="hidden" name="Alerte" id="Alerte" value="@PageLayout.Alerte" />

    @if (PageLayout.ShowOnlyRenderBody)
    {
        <div class="container-fluid p-3">
            @RenderBody()
        </div>
    }
    else
    {
        <!-- Barre du haut -->
        <div class="topbar d-print-none">
            <div class="container-fluid">
                <nav class="topbar-custom d-flex justify-content-between" id="topbar-custom">

                    <ul class="topbar-item list-unstyled d-inline-flex align-items-center mb-0">
                        <li>
                            <button class="nav-link mobile-menu-btn nav-icon" id="togglemenu" type="button" title="Menu">
                                <i class="iconoir-menu"></i>
                            </button>
                        </li>
                        <li class="mx-3 d-none d-lg-block lc-greeting">@salutation</li>
                        @if (PageLayout.CanSearch)
                        {
                            <li class="hide-phone app-search">
                                <form role="search" id="searchForm" action="/immo/select/" method="post">
                                    <input type="search" name="Code" id="search" class="form-control top-search mb-0" placeholder="Rechercher un bien..." autocomplete="off" />
                                    <button type="submit"><i class="iconoir-search"></i></button>
                                </form>
                            </li>
                        }
                    </ul>

                    <ul class="topbar-item list-unstyled d-inline-flex align-items-center mb-0">
                        <li class="topbar-item">
                            <a class="nav-link nav-icon" href="javascript:void(0);" id="light-dark-mode" title="Thème clair / sombre">
                                <i class="iconoir-half-moon dark-mode"></i>
                                <i class="iconoir-sun-light light-mode"></i>
                            </a>
                        </li>

                        <li class="dropdown topbar-item">
                            <a class="nav-link dropdown-toggle arrow-none nav-icon" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false" data-bs-offset="0,19">
                                <img src="@photoUser" alt="" class="thumb-md rounded-circle" />
                            </a>
                            <div class="dropdown-menu dropdown-menu-end py-0">
                                <div class="d-flex align-items-center dropdown-item py-2 bg-secondary-subtle">
                                    <div class="flex-shrink-0">
                                        <img src="@photoUser" alt="" class="thumb-md rounded-circle" />
                                    </div>
                                    <div class="flex-grow-1 ms-2 text-truncate align-self-center">
                                        <h6 class="my-0 fw-medium text-body fs-13">@userFullName</h6>
                                        <small class="text-muted mb-0">@PageLayout.Identity.Profil?.Libelle</small>
                                    </div>
                                </div>
                                <div class="dropdown-divider mt-0"></div>
                                <small class="text-muted px-2 pb-1 d-block">@PageLayout.Identity.Institution?.Nom</small>
                                @{ int profilIndex = 0; }
                                @foreach (var groupMenu in groupsMenuProfil)
                                {
                                    profilIndex++;
                                    if (groupsMenuProfil.Count > 1 && profilIndex == groupsMenuProfil.Count)
                                    {
                                        <div class="dropdown-divider mb-0"></div>
                                    }
                                    <a class="dropdown-item" href="@groupMenu.Url"><i class="material-icons">@groupMenu.Icone</i>@groupMenu.Libelle</a>
                                }
                            </div>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

        <!-- Barre latérale -->
        <div class="startbar d-print-none">
            <div class="brand">
                <a href="@homeUrl" class="logo">
                    <span>
                        <img src="~/Content/images/locate-icon.png" alt="Locate" class="logo-sm" />
                    </span>
                    <span class="">
                        <img src="~/Content/images/locate-logo.png" alt="Locate" class="logo-lg logo-light" />
                        <img src="~/Content/images/locate-logo.png" alt="Locate" class="logo-lg logo-dark" />
                    </span>
                </a>
            </div>
            <div class="startbar-menu">
                <div class="startbar-collapse" id="startbarCollapse" data-simplebar>
                    <div class="d-flex align-items-start flex-column w-100">
                        <ul class="navbar-nav mb-auto w-100">
                            <li class="menu-label mt-2">
                                <span>Navigation</span>
                            </li>

                            @{ int groupIndex = 0; }
                            @foreach (var groupMenu in PageLayout.Identity.GroupMenu)
                            {
                                if (groupMenu.Section != "Principale" || groupMenu.Menu == null || groupMenu.Menu.Count == 0)
                                {
                                    continue;
                                }

                                groupIndex++;

                                if (groupMenu.Menu.Count == 1)
                                {
                                    string activeSingle = PageLayout.CurrentClaim == groupMenu.Menu[0].Nom ? "active" : "";

                                    <li class="nav-item">
                                        <a class="nav-link @activeSingle" href="@groupMenu.Menu[0].Url">
                                            <i class="material-icons menu-icon">@groupMenu.Icone</i>
                                            <span>@groupMenu.Menu[0].Libelle</span>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    bool isActiveGroup = false;
                                    foreach (var menu in groupMenu.Menu)
                                    {
                                        if (PageLayout.CurrentClaim == menu.Nom) { isActiveGroup = true; break; }
                                    }

                                    string activeGroup = isActiveGroup ? "active" : "";
                                    string showGroup = isActiveGroup ? "show" : "";
                                    string expandedGroup = isActiveGroup ? "true" : "false";
                                    string collapseId = "sidebarGroup" + groupIndex;

                                    <li class="nav-item">
                                        <a class="nav-link @activeGroup" href="#@collapseId" data-bs-toggle="collapse" role="button" aria-expanded="@expandedGroup" aria-controls="@collapseId">
                                            <i class="material-icons menu-icon">@groupMenu.Icone</i>
                                            <span>@groupMenu.Libelle</span>
                                        </a>
                                        <div class="collapse @showGroup" id="@collapseId">
                                            <ul class="nav flex-column">
                                                @foreach (var menu in groupMenu.Menu)
                                                {
                                                    string activeMenu = PageLayout.CurrentClaim == menu.Nom ? "active" : "";
                                                    <li class="nav-item">
                                                        <a class="nav-link @activeMenu" href="@menu.Url">@menu.Libelle</a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </li>
                                }
                            }
                        </ul>

                        <div class="update-msg text-center">
                            <div class="d-flex justify-content-center align-items-center thumb-lg update-icon-box rounded-circle mx-auto">
                                <i class="iconoir-qr-code h3 align-self-center mb-0 text-primary"></i>
                            </div>
                            <h5 class="mt-3">@PageLayout.AppName <span class="text-white">@appVersion</span></h5>
                            <p class="lc-editeur-libelle mb-1">Une solution</p>
                            <img src="~/Content/images/randarecx-logo-clair.png" alt="@company" class="lc-editeur-logo mb-2" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="startbar-overlay d-print-none"></div>

        <!-- Contenu -->
        <div class="page-wrapper">
            <div class="page-content">
                <div class="container-fluid">

                    @if (!string.IsNullOrEmpty(pageTitle))
                    {
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="page-title-box d-md-flex justify-content-md-between align-items-center">
                                    <div>
                                        <h4 class="page-title">@pageTitle</h4>
                                        @if (!string.IsNullOrEmpty(pageSousTitre))
                                        {
                                            <p class="lc-page-subtitle d-none d-md-block">@pageSousTitre</p>
                                        }
                                    </div>
                                    <div class="">
                                        <ol class="breadcrumb mb-0">
                                            <li class="breadcrumb-item"><a href="@homeUrl">@PageLayout.AppName</a></li>
                                            @if (groupeCourant != null)
                                            {
                                                <li class="breadcrumb-item">@groupeCourant.Libelle</li>
                                            }
                                            <li class="breadcrumb-item active">@pageTitle</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @RenderBody()

                </div>

                <footer class="footer text-center text-sm-start d-print-none">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12">
                            <div class="card mb-0 rounded-bottom-0">
                                <div class="card-body">
                                    <p class="text-muted mb-0">
                                        &copy; @DateTime.Now.Year @company. Tous droits réservés.
                                        <span class="text-muted d-none d-sm-inline-block float-end">@PageLayout.AppName &middot; version @appVersion</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                </footer>
            </div>
        </div>
    }

    @Html.Partial("Views/Layout/_Scripts.cshtml")

</body>
</html>
