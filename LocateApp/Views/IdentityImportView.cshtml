@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using System.Linq;
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Utilities;
@using LocateApp.Controllers;
@using System.Collections.Generic;


@{ IdentityImportViewModel Page = (IdentityImportViewModel)Model; }

@{ ViewBag.Page = Page;
    string libellePage = Page.MenuData?.Libelle;
    string cheminPhotos = Utilities.GetPhotoAgentPath();
    int nbAgents = Page.Agents == null ? 0 : Page.Agents.Count;
    // Noms des organes déjà lus (évite une requête par ligne quand plusieurs agents partagent le même organe).
    Dictionary<string, string> nomsOrganes = new Dictionary<string, string>();
 }

@{ Layout = "Views/Layout/_Layout.cshtml";}

<style>
    #AgentSelected:empty::before {
        content: "Aucun agent sélectionné pour l'instant : choisissez un profil dans la dernière colonne.";
        color: var(--bs-secondary-color);
    }
    #example td input[type=checkbox] {
        margin-right: .5rem;
        vertical-align: middle;
    }
</style>

<input type="hidden" id="NbrePatientTotal" name="NbrePatientTotal" value="@nbAgents" />

<form action="/utilisateur/import/" method="post">

    <span id="insertValues">
    </span>

    <input type="hidden" id="pathPhotoUser" name="pathPhotoUser" value="@Utilities.GetPhotoAgentPath()" />

    <div class="card">
        <div class="card-header">
            <div class="row align-items-center g-2">
                <div class="col">
                    <h4 class="card-title">@libellePage</h4>
                    <p class="lc-card-subtitle">@(string.IsNullOrEmpty(Page.Description) ? "Agents actifs du référentiel qui n'ont pas encore de compte." : Page.Description) Attribuez un profil à chaque agent à importer, puis validez.</p>
                </div>
                <div class="col-auto lc-card-actions">
                    <a href="/utilisateur/" class="btn btn-light"><i class="iconoir-arrow-left me-1"></i>Utilisateurs</a>
                    <a href="javascript:void(0)" onclick="$(this).promptUrl('Importation des agents','/utilisateur/import/', 'Qui voulez-vous importer comme utilisateur ?', 'Saisissez une info de l\'agent')" class="btn btn-soft-primary"><i class="iconoir-search me-1"></i>Nouvelle recherche</a>
                    <button type="submit" class="btn btn-primary"><i class="iconoir-user-plus me-1"></i>Importer la sélection</button>
                </div>
            </div>
        </div>
        <div class="card-body pt-0">

            <div class="lc-callout mb-3">
                <i class="iconoir-group"></i>
                <div class="flex-grow-1">
                    <div class="fw-semibold mb-1">Agents sélectionnés</div>
                    <div id="AgentSelected" class="d-flex flex-wrap gap-1"></div>
                </div>
            </div>

            @if (nbAgents == 0)
            {
                <div class="lc-empty">
                    <div class="lc-empty-icon"><i class="iconoir-search"></i></div>
                    <h6>Aucun agent à importer</h6>
                    <p>Aucun agent actif sans compte ne correspond à la recherche.</p>
                    <a href="javascript:void(0)" onclick="$(this).promptUrl('Importation des agents','/utilisateur/import/', 'Qui voulez-vous importer comme utilisateur ?', 'Saisissez une info de l\'agent')" class="btn btn-primary btn-sm"><i class="iconoir-search me-1"></i>Nouvelle recherche</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table id="example" class="table lc-table w-100">
                        <thead class="table-light">
                            <tr>
                                <th>Matricule</th>
                                <th>Agent</th>
                                <th>Organe</th>
                                <th style="min-width: 240px;">Profil à attribuer</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var agent in Page.Agents)
                            {
                                string link = Page.Link + agent.Matricule.Substring(0, 6);
                                string td = "td" + agent.Matricule;
                                string agentName = $"{agent.Nom?.Trim()} {agent.Postnom?.Trim()} {agent.Prenom?.Trim()}";
                                string nomComplet = agentName.Trim();
                                // La photo est vérifiée sur le serveur de photos : une seule lecture par agent.
                                string photo = agent.Photo;
                                string photoUser = cheminPhotos + photo;
                                string idSelect = agent.Matricule + "_0_" + agentName + "_" + photo;
                                string naissance = agent.DateNaissance.Year > 1900 ? ((agent.Sexe == 1) ? "Né le " : "Née le ") + agent.DateNaissance.ToString("dd/MM/yyyy") : null;
                                string nomOrgane = null;
                                if (!string.IsNullOrEmpty(agent.CodeOrgane))
                                {
                                    if (!nomsOrganes.TryGetValue(agent.CodeOrgane, out nomOrgane))
                                    {
                                        nomOrgane = OrganeController.SelectNameById(agent.CodeOrgane);
                                        nomsOrganes[agent.CodeOrgane] = nomOrgane;
                                    }
                                }

                                <tr>
                                    <td id="@td">
                                        <label for="@("Matricule" + agent.Matricule)" class="mb-0"><a href="@Html.Raw(link)" class="lc-code text-decoration-none">@agent.Matricule</a></label>
                                    </td>
                                    <td data-order="@nomComplet">
                                        <div class="lc-entity">
                                            <img src="@photoUser" alt="@nomComplet" data-zoom-legende="@nomComplet (@agent.Matricule)" class="lc-thumb avatar-zoom" loading="lazy" />
                                            <div class="lc-entity-body">
                                                <a href="@Html.Raw(link)" class="lc-name">@nomComplet</a>
                                                <span class="lc-sub">@(agent.Genre + (naissance == null ? "" : " · " + naissance))</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(nomOrgane))
                                        {
                                            <span class="d-block text-body text-truncate" style="max-width: 280px;" title="@nomOrgane">@nomOrgane</span>
                                            <span class="d-block fs-12 text-muted mt-1"><span class="lc-code">@agent.CodeOrgane</span></span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <select name="IdProfilToSelect" onchange="$(this).choose('IdProfil')" class="js-states form-select" tabindex="-1" style="width: 100%" id="IdProfilToSelect">
                                            <option value="@idSelect" selected>Choisir un profil</option>
                                            @foreach (var profil in Page.Profils)
                                            {
                                                if (!profil.DefaultProfil && !profil.Externe)
                                                {
                                                    idSelect = agent.Matricule + "_" + profil.IdProfil + "_" + agentName + "_" + photo;
                                                    <option value="@idSelect">@profil.Nom</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        @if (nbAgents > 0)
        {
            <div class="card-footer lc-form-actions">
                <span class="lc-form-actions-start">Seuls les agents auxquels un profil est attribué sont importés.</span>
                <a href="/utilisateur/" class="btn btn-light">Annuler</a>
                <button type="submit" class="btn btn-primary"><i class="iconoir-check me-1"></i>Importer la sélection</button>
            </div>
        }
    </div>

</form>
