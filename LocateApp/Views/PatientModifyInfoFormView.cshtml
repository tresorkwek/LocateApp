@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using System.Linq;
@using System.Collections.Generic;


@{ // Binding du ViewModel.
    PatientModifyInfoViewModel Page = (PatientModifyInfoViewModel)Model; }

@{ ViewBag.Page = Page; }

@{ 
    Layout = "Views/Layout/_LayoutForm.cshtml"; 
}


<div>
    <div>
        <div class="row">
            <div class="col-12 col-md-12 col-lg-6 offset-lg-4 offset-md-1">
                <div class="card">
                    <div class="card-body">

                        <div class="card-title text-center text-primary f-bold f-s-17">@Page.Title</div>

                        <img src="/Content/images/photos/@Page.Patient.Photo" width="228px" class="rounded-circle" alt="">
                        <div class="row">
                            <form class="col-12" method="post" action="@Page.Link">

                                <div class="form-group mb-3 col-6"><br />
                                    <label class="form-label" for="MatriculeDisabled">Matricule</label>
                                    <input id="MatriculeDisabled" name="MatriculeDisabled" type="text" value="@Page.Patient.Matricule.Trim()" disabled class="form-control">
                                    <input type="hidden" id="Matricule" name="Matricule" value="@Page.Patient.Matricule.Trim()" />
                                </div>
                                <div class="form-group mb-3 col-6"><br />
                                    <label class="form-label" for="Nom">Nom</label>
                                    <input id="Nom" name="Nom" type="text" value="@Page.Patient.NomAfficheable" class="form-control">
                                </div>
                                <div class="form-group mb-3 col-6"><br />
                                    <label class="form-label" for="Postnom">Postnom</label>
                                    <input id="Postnom" name="Postnom" type="text" value="@Page.Patient.PostnomAfficheable" class="form-control">
                                </div>
                                <div class="form-group mb-3 col-6"><br />
                                    <label class="form-label" for="Prenom">Prénom</label>
                                    <input id="Prenom" name="Prenom" type="text" value="@Page.Patient.PrenomAfficheable" class="form-control">
                                </div>
                                <div class="form-group mb-3 col-6"><br />
                                    <label class="form-label" for="disabledBirthday">Date de naissance</label>
                                    <input id="disabledBirthday" type="text" value="@Page.Patient.DateNaissance" disabled class="form-control">
                                </div>
                                <div class="form-group mb-3 col-3"><br />
                                    @{ string checkedMasculin = (Page.Patient.SexeAfficheable == 1) ? "checked" : "";
                                        string checkedFeminin = (Page.Patient.SexeAfficheable == 2) ? "checked" : ""; }
                                    <div class="form-check"><input class="with-gap form-check-input" name="Sexe" value="1" type="radio" id="M" @checkedMasculin />
                                    <label class="form-check-label" for="M">M</label></div>
                                </div>
                                <div class="form-group mb-3 col-3"><br />
                                    <div class="form-check"><input class="with-gap form-check-input" name="Sexe" value="2" type="radio" id="F" @checkedFeminin />
                                    <label class="form-check-label" for="F">F</label></div>
                                </div>

                                <br /><br />

                                <div class="form-group mb-3 col-12">

                                    @{ string Commentaire = (Page.Patient.MoviaMatricule != null) ? Page.Patient.MoviaCommentaire : ""; }

                                    <label class="form-label" for="Commentaire">Commentaire</label>
                                    <textarea id="Commentaire" name="Commentaire" class="form-control">@Commentaire</textarea>
                                </div>

                                <div class="col-12 text-end mt-2">
                                    <button type="reset" class="btn btn-light">Annuler</button>
                                    <button type="submit" class="btn btn-success">Corriger</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>