@inherits Nancy.ViewEngines.Razor.NancyRazorViewBase<dynamic>
@using System.Collections.Generic;
@using System.Linq;
@using LocateApp.Models;
@using LocateApp.ViewModels;
@using LocateApp.Controllers;
@using LocateApp.Utilities;


@{ ClaimViewModel Page = (ClaimViewModel)Model; }

@{ ViewBag.Page = Page;
    string libellePage = Page.MenuData?.Libelle;

    List<Profil> profils = Page.Profils ?? new List<Profil>();

    // Menus rattachés à chaque groupe : une seule lecture par groupe pour toute la page.
    List<GroupMenu> groupes = GroupMenuController.GetAllGroupMenu() ?? new List<GroupMenu>();
    Dictionary<int, GroupMenu> groupeParMenu = new Dictionary<int, GroupMenu>();
    int nbMenus = 0;
    foreach (var g in groupes)
    {
        List<Menu> menusDuGroupe = g.AllMenu;
        if (menusDuGroupe == null) { continue; }
        foreach (var m in menusDuGroupe)
        {
            groupeParMenu[m.IdMenu] = g;
            nbMenus++;
        }
    }

    Dictionary<int, List<UserClaim>> droitsParProfil = new Dictionary<int, List<UserClaim>>();
    int nbDroits = 0;
    foreach (var p in profils)
    {
        List<UserClaim> claims = ClaimControllers.GetClaimsByProfilForConfig(p.IdProfil) ?? new List<UserClaim>();
        droitsParProfil[p.IdProfil] = claims;
        nbDroits += claims.Count;
    }

    List<Profil> profilsSansDroits = ProfilController.GetProfilWithoutClaims() ?? new List<Profil>();
}

@{ Layout = "Views/Layout/_Layout.cshtml";}

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
        <div class="lc-kpi">
            <span class="lc-kpi-icon bg-primary-subtle text-primary"><i class="iconoir-group"></i></span>
            <div>
                <p class="lc-kpi-label">Profils configurés</p>
                <p class="lc-kpi-value">@profils.Count<small>avec des droits</small></p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="lc-kpi">
            <span class="lc-kpi-icon bg-success-subtle text-success"><i class="iconoir-key-command"></i></span>
            <div>
                <p class="lc-kpi-label">Droits attribués</p>
                <p class="lc-kpi-value">@Utilities.FormatNumber(nbDroits, 0)<small>au total</small></p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="lc-kpi">
            <span class="lc-kpi-icon bg-info-subtle text-info"><i class="iconoir-list"></i></span>
            <div>
                <p class="lc-kpi-label">Menus disponibles</p>
                <p class="lc-kpi-value">@nbMenus<small>dans @groupes.Count groupes</small></p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="lc-kpi">
            <span class="lc-kpi-icon bg-warning-subtle text-warning"><i class="iconoir-warning-triangle"></i></span>
            <div>
                <p class="lc-kpi-label">Profils sans droits</p>
                <p class="lc-kpi-value">@profilsSansDroits.Count<small>à configurer</small></p>
            </div>
        </div>
    </div>
</div>

@if (profilsSansDroits.Count > 0)
{
    <div class="lc-callout lc-callout-warning mb-3">
        <i class="iconoir-warning-triangle"></i>
        <div class="flex-grow-1">
            <b>@profilsSansDroits.Count @(profilsSansDroits.Count > 1 ? "profils" : "profil") sans aucun droit :</b>
            @(string.Join(", ", profilsSansDroits.Select(x => x.Nom))).
            Leurs utilisateurs n'accèdent qu'aux menus par défaut.
        </div>
        <a href="/claim/add/" class="btn btn-sm btn-warning flex-shrink-0">Attribuer des droits</a>
    </div>
}

<div class="card">
    <div class="card-header">
        <div class="row align-items-center g-2">
            <div class="col">
                <h4 class="card-title">@libellePage</h4>
                <p class="lc-card-subtitle">Menus accessibles à chaque profil, regroupés par groupe de menus.</p>
            </div>
            <div class="col-auto lc-card-actions">
                <a href="/profil/" class="btn btn-light"><i class="iconoir-group me-1"></i>Profils</a>
                <a href="/claim/add/" class="btn btn-primary"><i class="iconoir-plus me-1"></i>Attribuer des droits</a>
            </div>
        </div>
    </div>
    <div class="card-body pt-0">
        @if (profils.Count == 0)
        {
            <div class="lc-empty">
                <div class="lc-empty-icon"><i class="iconoir-key-command"></i></div>
                <h6>Aucun droit attribué</h6>
                <p>Choisissez un profil et cochez les menus auxquels ses utilisateurs doivent accéder.</p>
                <a href="/claim/add/" class="btn btn-primary btn-sm"><i class="iconoir-plus me-1"></i>Attribuer des droits</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="example" class="table lc-table w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Profil</th>
                            <th>Type</th>
                            <th>Droits</th>
                            <th>Groupes de menus couverts</th>
                            <th>Page d'accueil</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var menu in Page.Profils)
                        {
                            string link = Page.Link + menu.IdProfil;
                            List<UserClaim> claims = droitsParProfil.ContainsKey(menu.IdProfil) ? droitsParProfil[menu.IdProfil] : new List<UserClaim>();
                            int nb = claims.Count;
                            int pourcentage = nbMenus > 0 ? (int)Math.Round(nb * 100.0 / nbMenus) : 0;
                            if (pourcentage > 100) { pourcentage = 100; }

                            // Nombre de droits par groupe, dans l'ordre des groupes.
                            List<KeyValuePair<GroupMenu, int>> couverture = new List<KeyValuePair<GroupMenu, int>>();
                            foreach (var g in groupes)
                            {
                                int n = claims.Count(c => groupeParMenu.ContainsKey(c.IdMenu) && groupeParMenu[c.IdMenu].IdGroupMenu == g.IdGroupMenu);
                                if (n > 0) { couverture.Add(new KeyValuePair<GroupMenu, int>(g, n)); }
                            }

                            string nom = menu.Nom ?? "";
                            string[] mots = nom.Split(new[] { ' ', '-', '_', '.' }, StringSplitOptions.RemoveEmptyEntries);
                            string initiales = mots.Length >= 2 ? mots[0].Substring(0, 1) + mots[1].Substring(0, 1) : (nom.Length >= 2 ? nom.Substring(0, 2) : nom);
                            string couleur = menu.Externe ? "info" : "primary";

                            <tr>
                                <td>
                                    <div class="lc-entity">
                                        <span class="lc-thumb rounded-circle lc-initials bg-@couleur-subtle text-@couleur">@initiales</span>
                                        <div class="lc-entity-body">
                                            <a href="@Html.Raw(link)" class="lc-name">@menu.Nom</a>
                                            <span class="lc-sub">@(string.IsNullOrWhiteSpace(menu.Libelle) ? "Aucun libellé" : menu.Libelle)</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (menu.Externe)
                                        {
                                            <span class="badge lc-badge bg-info-subtle text-info"><i class="iconoir-globe"></i>Externe</span>
                                        }
                                        else
                                        {
                                            <span class="badge lc-badge bg-secondary-subtle text-secondary"><i class="iconoir-user"></i>Interne</span>
                                        }
                                        @if (menu.DefaultProfil)
                                        {
                                            <span class="badge lc-badge bg-success-subtle text-success"><i class="iconoir-check"></i>Par défaut</span>
                                        }
                                    </div>
                                </td>
                                <td data-order="@nb" style="min-width: 140px">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="lc-count">@nb</span>
                                        <span class="fs-12 text-muted">sur @nbMenus menus</span>
                                    </div>
                                    <div class="lc-progress"><div class="progress-bar bg-primary" style="width: @pourcentage%"></div></div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var item in couverture.Take(4))
                                        {
                                            <span class="badge lc-badge bg-light text-body border" title="@item.Key.Libelle : @item.Value droit(s)" data-bs-toggle="tooltip">
                                                <i class="material-icons">@item.Key.Icone</i>@(string.IsNullOrWhiteSpace(item.Key.Libelle) ? item.Key.Nom : item.Key.Libelle)<span class="text-muted fw-normal ms-1">@item.Value</span>
                                            </span>
                                        }
                                        @if (couverture.Count > 4)
                                        {
                                            <span class="badge lc-badge bg-primary-subtle text-primary" title="@(string.Join(", ", couverture.Skip(4).Select(x => x.Key.Libelle)))" data-bs-toggle="tooltip">+@(couverture.Count - 4)</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(menu.HomeUrl))
                                    {
                                        <span class="lc-code">@menu.HomeUrl</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!menu.Root)
                                    {
                                        <span class="lc-actions">
                                            <a href="@Html.Raw(link)" title="Modifier les droits" data-bs-toggle="tooltip"><i class="iconoir-key-command"></i></a>
                                            <a href="/profil/modify/@menu.IdProfil" title="Modifier le profil" data-bs-toggle="tooltip"><i class="iconoir-edit-pencil"></i></a>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
