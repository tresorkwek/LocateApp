<Project Sdk="Microsoft.NET.Sdk">

  <!-- Locate Terrain : application mobile native (.NET MAUI) des agents d'inventaire.
       Elle n'embarque aucune logique métier : elle consomme les routes JSON existantes du serveur Locate,
       exactement comme la version web mobile (Content/mobile). Cible Android ; Windows/iOS peuvent être ajoutés
       dans TargetFrameworks quand les charges de travail correspondantes sont disponibles. -->

  <PropertyGroup>
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>LocateMobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>Locate Terrain</ApplicationTitle>
    <ApplicationId>com.randarecx.locate</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <MauiVersion>9.0.120</MauiVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <!-- APK Debug installable directement (signature de debug), sans AOT pour compiler vite. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <RunAOTCompilation>false</RunAOTCompilation>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#3167f3" BaseSize="200,200" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.6.0" />
  </ItemGroup>

</Project>
